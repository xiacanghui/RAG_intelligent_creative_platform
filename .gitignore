# ============================================
# 地域非遗文脉RAG智能创作平台 - Git忽略配置
# ============================================

# 环境变量（包含API密钥，不能上传）
.env

# Python缓存
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# 日志文件
logs/

# 向量库数据（可重新生成）
vector_store/

# 本地模型文件（太大，不能上传）
*.gguf
*.bin

# Ollama配置
Modelfile

# Windows批处理文件
启动微服务.bat
一键启动.bat
start_ollama.bat

# 归档文件
archive/

# 虚拟环境
.venv/
venv/
ENV/

# IDE配置
.vscode/
.idea/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db
