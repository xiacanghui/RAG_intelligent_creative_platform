# ============================================
# 地域非遗文脉RAG智能创作平台 - 环境变量配置模板
# ============================================
# Render部署时在Environment Variables中配置这些值
# 本地开发时复制本文件为 .env 并填写真实密钥

# Ollama 本地模型配置（Render部署时留空）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# 智谱 GLM-4-Flash 云端API（免费）
ZHIPU_API_KEY=your_zhipu_api_key_here

# 硅基流动 DeepSeek-R1 云端API
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# DeepSeek 官方API（当前未启用）
DEEPSEEK_API_KEY=

# Agnes AI 纹样生图API
AGNES_API_KEY=your_agnes_api_key_here

# FastAPI 服务配置
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# ChromaDB 向量库路径
CHROMA_PERSIST_DIR=./vector_store

# 知识库文档路径
KNOWLEDGE_BASE_DIR=./knowledge_base

# 日志存储路径
LOG_DIR=./logs
